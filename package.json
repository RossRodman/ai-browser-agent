{
  "name": "ai-browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup:browsers": "npm exec -w @aba/agent -- playwright install chromium",
    "demo": "npm run dev -w @aba/demo-site",
    "approval": "npm run ui -w @aba/agent",
    "agent:scan": "npm run scan -w @aba/agent",
    "agent:execute": "npm run execute -w @aba/agent --",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
